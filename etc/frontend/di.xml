<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Catalog\Pricing\Render\FinalPriceBox">
        <plugin name="shoppy_hideprice_plugin"
                type="Shoppy\HidePrice\Plugin\HidePricePlugin"/>
    </type>

    <type name="Magento\Catalog\Model\Product">
        <plugin name="shoppy_hideprice_saleable_plugin"
                type="Shoppy\HidePrice\Plugin\SaleablePlugin"/>
    </type>

    <type name="Magento\Checkout\Controller\Cart\Add">
        <plugin name="shoppy_hideprice_addtocart_plugin"
                type="Shoppy\HidePrice\Plugin\AddToCartPlugin"/>
    </type>

</config>
